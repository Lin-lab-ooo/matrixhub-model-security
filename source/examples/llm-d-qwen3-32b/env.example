# Replace this value with a MatrixHub IP and port reachable from the llm-d model server Pods.
# Do not use 127.0.0.1 unless MatrixHub runs inside the same Pod.
MATRIXHUB_ENDPOINT="http://10.0.0.20:9527"

# Existing MatrixHub workload. Its logs are collected during the cached run.
MATRIXHUB_NAMESPACE="matrixhub"
MATRIXHUB_DEPLOYMENT="matrixhub"

# Namespace for the shared llm-d Router and both sequential model-loading runs.
LLMD_NAMESPACE="matrixhub-llmd-qwen3-32b"

# Optional. Set a node name to schedule each model-server Pod on that node.
# It is applied as kubernetes.io/hostname=<value>.
MODEL_NODE_SELECTOR=""

# llm-d Router standalone chart. Change LLMD_ROUTER_CHART if your cluster
# reaches this OCI artifact through a registry mirror.
LLMD_ROUTER_CHART="oci://ghcr.io/llm-d/charts/llm-d-router-standalone"
LLMD_ROUTER_CHART_VERSION="v0.9.0"
LLMD_ROUTER_RELEASE="optimized-baseline"
